{
  "permissions": {
    "allow": [
      "Bash(ssh devvm-achristensen *)",
      "Bash(bake *)",
      "Bash(bake-mirrors *)",
      "Bash(/home/achristensen/.cargo/bin/cargo +1.99.1 build --manifest-path /home/achristensen/dev/gitlab/okilani/tricorder/*)",
      "Bash(/home/achristensen/.cargo/bin/cargo +1.99.1 test --manifest-path /home/achristensen/dev/gitlab/okilani/tricorder/*)",
      "Bash(/home/achristensen/.cargo/bin/cargo +1.99.1 clippy --manifest-path /home/achristensen/dev/gitlab/okilani/tricorder/*)",
      "Bash(/home/achristensen/.cargo/bin/cargo +1.99.1 fmt --manifest-path /home/achristensen/dev/gitlab/okilani/tricorder/*)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/aj/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "pyright-lsp@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "diagram-design@diagram-design": true,
    "skins@hellosverre-mods": true
  },
  "extraKnownMarketplaces": {
    "diagram-design": {
      "source": {
        "source": "github",
        "repo": "cathrynlavery/diagram-design"
      }
    },
    "hellosverre-mods": {
      "source": {
        "source": "github",
        "repo": "hellosverre/claude-skins"
      }
    },
    "aj-mods": {
      "source": {
        "source": "directory",
        "path": "/Users/aj/dev/local/claude-mods"
      }
    }
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "network": {
      "allowUnixSockets": [
        "/Users/aj/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
      ]
    },
    "filesystem": {
      "allowWrite": [
        "~/.config/gcloud"
      ]
    },
    "excludedCommands": [
      "gh *"
    ]
  },
  "syntaxHighlightingDisabled": false,
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": true,
  "theme": "custom:catppucin-mocha",
  "autoMode": {
    "allow": [
      "$defaults",
      "Running `bake`, `bake-mirrors`, or `ssh devvm-achristensen ...`. devvm-achristensen is the user's own GCP developer VM, reached over an IAP tunnel. It is the sanctioned execution host for the lpu-monorepo Bake/Nix build system, which pins system = \"x86_64-linux\" and therefore cannot run on macOS. `bake` here is a local shim at ~/bin/bake that mirrors the current git worktree to that VM and runs the real bake there."
    ]
  }
}

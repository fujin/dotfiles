{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "\"$HOME/.codex/hooks/post_tool_use_quality_checks.sh\"",
            "statusMessage": "Running changed-file quality checks",
            "timeout": 120,
            "type": "command"
          }
        ],
        "matcher": "Edit|Write"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash '/Users/aj/.codex/herdr-agent-state.sh' session",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ]
  }
}
__open_files_limit=65536
__current_open_files_limit=$(ulimit -n)
if [ "$__current_open_files_limit" != "unlimited" ] && [ "$__current_open_files_limit" -lt "$__open_files_limit" ]; then
  ulimit -n "$__open_files_limit" 2>/dev/null || true
fi
unset __open_files_limit __current_open_files_limit

if command -v mise >/dev/null 2>&1; then
  eval "$(mise activate zsh)"
fi

